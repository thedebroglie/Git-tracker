PORT=5001
NODE_ENV=development
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/gitrank-v2

JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=7d

# Server-level GitHub PAT for GraphQL queries on behalf of all students
GITHUB_APP_TOKEN=ghp_your_server_pat_here

# GitHub App integration (Phase 0 locked baseline)
GITHUB_APP_ID=123456
GITHUB_APP_INSTALL_URL=https://github.com/apps/gittracker-local-dev/installations/new
GITHUB_APP_PRIVATE_KEY_BASE64=base64_encoded_pem_contents
GITHUB_APP_CLIENT_ID=Iv1.xxxxx
GITHUB_APP_CLIENT_SECRET=your_github_app_client_secret
GITHUB_APP_WEBHOOK_SECRET=replace_with_random_webhook_secret
GITHUB_APP_CALLBACK_URL=http://localhost:5001/auth/github/app/callback
GITHUB_WEBHOOK_DELIVERY_TTL_SECONDS=86400

# Phase 3 ingestion pipeline
INGESTION_MAX_RETRIES=3
WEBHOOK_ENVELOPE_RETENTION_DAYS=30
NORMALIZED_EVENT_RETENTION_DAYS=365
INGESTION_DEAD_LETTER_RETENTION_DAYS=90

# GitHub OAuth App credentials (for student ownership verification)
# Legacy fallback flow only; full GitHub App flow is the default baseline.
GITHUB_CLIENT_ID=your_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_oauth_app_client_secret
GITHUB_CALLBACK_URL=http://localhost:5001/auth/github/callback

# Google OAuth (for login page sign-in)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/auth/google/callback

# Redis
# Local dev: use the local Redis service you start on your machine.
REDIS_URL=redis://localhost:6379

# Production: replace with your managed Redis URL, for example Upstash/Redis Cloud.
# REDIS_URL=rediss://default:password@endpoint.upstash.io:30000

# App config
FRONTEND_URL=http://localhost:5173
SYNC_COOLDOWN_MINUTES=30

# Phase 7 leaderboard analytics/admin
ADMIN_API_KEY=replace_with_admin_panel_secret

# Phase 9 security controls
# Recommended: keep JWT within 12h-7d and never above 30d.
# JWT_EXPIRES_IN supports s/m/h/d format (example: 12h, 7d).
