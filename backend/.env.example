PORT=5001
NODE_ENV=development
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/gitrank-v2

JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=7d

# Server-level GitHub PAT for GraphQL queries on behalf of all students
GITHUB_APP_TOKEN=ghp_your_server_pat_here

# GitHub OAuth App credentials (for student ownership verification)
GITHUB_CLIENT_ID=your_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_oauth_app_client_secret
GITHUB_CALLBACK_URL=http://localhost:5001/auth/github/callback

# Redis (Upstash Cloud URL or Localhost)
REDIS_URL=rediss://default:password@endpoint.upstash.io:30000
# REDIS_HOST=localhost
# REDIS_PORT=6379

# App config
FRONTEND_URL=http://localhost:3000
SYNC_COOLDOWN_MINUTES=30
